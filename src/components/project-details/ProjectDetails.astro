---
import { Image } from 'astro:assets';
import type { ProjectCaseStudy } from '../../types/project-details';
import { templateStudies, templateLabels } from '../../data/project-details';
import Newspaper from '../../layouts/Newspaper.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Action from '../Action.astro';
import DetailSection from './DetailSection.astro';
import ProcessTimeline from './ProcessTimeline.astro';
import ImplementationModules from './ImplementationModules.astro';
import TemplateScene from './TemplateScene.astro';
import ArchitectureMap from './ArchitectureMap.astro';
import ProjectVisual from './ProjectVisual.astro';
import '../../styles/project-details.css';
interface Props { study: ProjectCaseStudy; preview?: boolean; }
const { study, preview = false } = Astro.props;
const draft = study.mode === 'example' || study.process.some(stage => stage.status === 'pending');
const sections = [
  { id: 'proceso', label: 'Proceso' }, { id: 'arquitectura', label: 'Arquitectura' },
  { id: 'implementacion', label: 'Implementación' },
  ...(study.decisions.length ? [{ id: 'decisiones', label: 'Decisiones' }] : []),
];
---
<Newspaper title={`${study.title} · Adrian Dev`} description={study.objective} noIndex={preview || draft}>
  <SiteHeader />
  <main id="contenido" class:list={['case-page', `case-page--${study.template}`]}>
    <div class="case-breadcrumb"><a href="/proyectos/"><span aria-hidden="true">←</span> Volver a proyectos</a><span class="eyebrow">{templateLabels[study.template]}</span></div>
    {preview && <nav class="template-switcher" aria-label="Variantes de la plantilla">
      {templateStudies.map(item => <a href={`/plantillas/${item.slug}/`} aria-current={item.template === study.template ? 'page' : undefined}>{templateLabels[item.template]}</a>)}
    </nav>}
    {study.mode === 'example' && <p class="case-notice"><span>Ejemplo de plantilla</span>{study.notice}</p>}
    <section class="case-hero" aria-labelledby="case-title">
      <div class="case-hero__copy">
        <span class="eyebrow">{study.subtitle}</span>
        <h1 id="case-title">{study.title}<span class="coral">.</span></h1>
        <p class="case-objective">{study.objective}</p>
        <dl class="case-facts"><div><dt>Rol</dt><dd>{study.role}</dd></div><div><dt>Alcance</dt><dd>{study.scope}</dd></div></dl>
        <ul class="tag-list case-stack" aria-label="Stack del proyecto">{study.technologies.map(item => <li class="tag">{item}</li>)}</ul>
        <div class="case-actions">
          {study.siteUrl && <Action href={study.siteUrl} label="Visitar página" variant="solid" icon="arrow" />}
          {study.demoUrl && <Action href={study.demoUrl} label="Ver demo" variant="solid" icon="arrow" />}
          {study.documentationUrl && <Action href={study.documentationUrl} label="Ver documentación" icon="arrow" />}
          {study.repositoryUrl && <Action href={study.repositoryUrl} label="Ver repositorio" icon="github" />}
        </div>
      </div>
      <ProjectVisual id="portada-visual" title={study.image ? `Portada de ${study.title}` : 'Vista ilustrativa del template'} caption={study.image ? 'Captura del sitio publicado.' : 'Esquema de presentación. No corresponde a un proyecto realizado.'}>
        {study.image ? <Image class="case-cover" src={study.image.src} alt={study.image.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 90vw, 48vw" loading="eager" format="webp" /> : <TemplateScene template={study.template} />}
      </ProjectVisual>
    </section>
    <nav class="case-contents" aria-label="Contenido del caso"><span class="eyebrow">En esta edición</span>{sections.map((section,index) => <a href={`#${section.id}`}><span aria-hidden="true">0{index+1}</span>{section.label}</a>)}</nav>
    <DetailSection id="proceso" number="01" title="Cómo lo desarrollé" caption="Del alcance a la integración: las etapas del desarrollo.">
      <ProcessTimeline stages={study.process} />
    </DetailSection>
    <DetailSection id="arquitectura" number="02" title="Arquitectura y conexiones" caption="Qué conecta con qué, dónde se ejecuta y qué intercambia.">
      <div id="arquitectura-visual">
        <ArchitectureMap architecture={study.architecture} id={`architecture-${study.slug}`} />
      </div>
    </DetailSection>
    <DetailSection id="implementacion" number="03" title="Implementación y componentes" caption="Las piezas del proyecto, su tecnología y cómo se integran.">
      <ImplementationModules modules={study.modules} example={study.mode === 'example'} />
    </DetailSection>
    {!!study.decisions.length && <DetailSection id="decisiones" number="04" title="Decisiones técnicas" caption={study.mode === 'example' ? 'Criterios ilustrativos de organización del código.' : 'Las elecciones que dan forma a esta solución.'}>
      <div class="case-decisions">{study.decisions.map((decision,index) => <article><span class="eyebrow">Decisión 0{index+1} · {decision.target}</span><dl><div><dt>Necesidad</dt><dd>{decision.need}</dd></div><div><dt>Elección</dt><dd>{decision.choice}</dd></div><div><dt>Efecto{study.mode === 'example' && ' esperado'}</dt><dd>{decision.effect}</dd></div></dl><a href="#arquitectura">Ubicar en el mapa <span aria-hidden="true">↗</span></a></article>)}</div>
    </DetailSection>}
    <div class="case-closing"><div><span class="eyebrow">Fin de esta edición</span><p>{study.mode === 'example' ? 'Una estructura para contar tu próximo proyecto.' : 'Arquitectura y desarrollo, contados desde el código.'}</p></div><Action href="/proyectos/" label="Volver a proyectos" icon="arrow" /></div>
    {preview && <p class="template-index-link"><a href="/plantillas/">Ver los cuatro templates</a></p>}
  </main>
  <SiteFooter backHref="/proyectos/" backLabel="Volver a proyectos" />
</Newspaper>
