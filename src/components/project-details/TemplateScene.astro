---
import type { ProjectTemplate } from '../../types/project-details';
interface Props { template: ProjectTemplate; }
const { template } = Astro.props;
---
<div class:list={['template-scene', `template-scene--${template}`]} aria-label="Esquema ilustrativo del template; no es una captura de un proyecto realizado">
  <div class="template-scene__bar"><span aria-hidden="true">○ ○ ○</span><span>Esquema ilustrativo</span></div>
  {template === 'ecommerce' ? <div class="store-scene">
    <div class="store-scene__product"><span class="eyebrow">Producto</span><svg viewBox="0 0 160 150" aria-hidden="true"><path d="m35 42 45-24 45 24-45 25Z"/><path d="M35 42v64l45 25 45-25V42M80 67v64M57 30l45 25v30"/></svg><span>Selección → Carrito</span></div>
    <div class="store-scene__order"><span class="eyebrow">Pedido</span><span class="scene-skeleton"></span><span class="scene-skeleton"></span><span class="scene-skeleton scene-skeleton--short"></span><div class="scene-stamp">Compra<br/>confirmada <span aria-hidden="true">✓</span></div></div>
  </div> : template === 'web-app' ? <div class="app-scene">
    <div class="app-scene__screen"><span class="eyebrow">Interfaz</span><div class="app-scene__rows">{['Acción del usuario', 'Validación', 'Estado actualizado'].map((item,index) => <span><b>{index+1}</b>{item}<i aria-hidden="true">{index===2?'✓':'—'}</i></span>)}</div></div>
    <div class="app-scene__service"><span class="scene-link" aria-hidden="true">↔</span><span>API</span><small>Reglas de negocio</small><svg viewBox="0 0 120 70" aria-hidden="true"><ellipse cx="60" cy="14" rx="37" ry="10"/><path d="M23 14v38c0 14 74 14 74 0V14M23 32c0 14 74 14 74 0"/></svg><small>Persistencia</small></div>
  </div> : <div class="api-scene">
    <span class="eyebrow">Una operación, de extremo a extremo</span>
    <div class="api-scene__chain"><span>Cliente</span><i aria-hidden="true">→</i><span>API</span><i aria-hidden="true">→</i><span>Datos</span></div>
    <div class="api-scene__payload"><span>Petición <b aria-hidden="true">↗</b></span><code>{'{ "entrada": "…" }'}</code><span>Respuesta <b aria-hidden="true">↙</b></span><code>{'{ "resultado": "…" }'}</code></div>
  </div>}
</div>
