---
import { Image } from 'astro:assets';
import type { PortfolioImage } from '../data/portfolio';
interface Props { image?: PortfolioImage; }
const { image } = Astro.props;
---
<figure class="portrait">
  {image ? (
    <Image src={image.src} alt={image.alt} widths={[240, 400, 600]} sizes="(max-width: 600px) 200px, (max-width: 860px) 210px, 270px" loading="eager" fetchpriority="high" format="webp" />
  ) : (
    <div class="portrait-placeholder" aria-label="Espacio reservado para tu fotografía">
      <span class="portrait-corner portrait-corner--tl"></span><span class="portrait-corner portrait-corner--br"></span>
      <svg viewBox="0 0 160 190" width="160" height="190" fill="none" aria-hidden="true">
        <defs><pattern id="portrait-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)"><path d="M0 0v5" stroke="currentColor" stroke-width=".6" /></pattern></defs>
        <ellipse cx="80" cy="68" rx="32" ry="40" fill="url(#portrait-hatch)" />
        <path d="M61 104v15l19 14 19-14v-15M61 119l-28 16-17 42h128l-17-42-28-16M80 133v44" stroke="currentColor" stroke-width="1" />
        <path d="m61 119-5 24 24-10 24 10-5-24" stroke="currentColor" stroke-width="1" />
        <ellipse cx="80" cy="68" rx="32" ry="40" stroke="currentColor" stroke-width="1" />
      </svg>
      <span class="portrait-placeholder__label">Tu fotografía aquí</span>
    </div>
  )}
  <figcaption><span>Fig. 01</span><span>{image ? 'El autor' : 'Retrato pendiente'}</span></figcaption>
</figure>
