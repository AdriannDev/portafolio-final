---
interface Props { id?: string; }
const { id = 'cv-octocat' } = Astro.props;
const eyeClipId = `${id}-eyes`;
---
<!-- Layered resting illustration; visual reference: https://octodex.github.com/original/ -->
<span class="octocat-rest" data-motion aria-hidden="true">
  <svg class="octocat-art" viewBox="0 0 160 132" width="80" height="66" fill="currentColor" focusable="false">
    <defs>
      <clipPath id={eyeClipId}>
        <ellipse cx="62" cy="67" rx="7.2" ry="10.2" />
        <ellipse cx="100" cy="67" rx="7.2" ry="10.2" />
      </clipPath>
    </defs>

    <g class="octocat-body">
      <path d="M65 85h31c7 8 11 19 10 36H54c-1-16 3-27 11-36Z" />
      <path d="M64 107c-13 10-26 7-34-2-4-5-11-5-12-1-1 7 12 22 29 23 9 1 17-2 22-6Z" />
      <g class="octocat-suckers" fill="#c3e3d7">
        <ellipse cx="24" cy="106" rx="2.7" ry="1.8" transform="rotate(27 24 106)" />
        <ellipse cx="32" cy="113" rx="2.7" ry="1.8" transform="rotate(25 32 113)" />
        <ellipse cx="42" cy="117" rx="2.7" ry="1.8" />
      </g>
    </g>

    <g transform="translate(0 24)">
    <g class="octocat-head">
      <path d="M38 30c-3-8-2-17 1-24 9 0 17 4 24 9 12-4 24-4 36 0 8-5 16-9 24-9 3 8 4 17 1 25 8 9 12 19 11 31 0 23-14 33-54 33S27 84 27 62c-1-12 3-23 11-32Z" />
      <g class="octocat-whiskers" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <path d="M32 70C20 66 10 66 1 68m32 7C20 72 10 73 1 77M130 70c12-4 22-4 29-2m-30 7c13-3 23-2 30 2" />
      </g>
      <path class="octocat-face" fill="#f4cab1" d="M56 51c9-1 16 1 25 1s17-2 26-1c14 1 20 11 20 22 0 16-15 20-46 20S35 89 35 73c0-11 7-21 21-22Z" />
      <g class="octocat-eyelids">
        <g class="octocat-eyes" fill="#fff" stroke="#fff" stroke-width="1.2">
          <ellipse cx="62" cy="67" rx="7.2" ry="10.2" />
          <ellipse cx="100" cy="67" rx="7.2" ry="10.2" />
        </g>
        <g clip-path={`url(#${eyeClipId})`}>
          <g class="octocat-pupils" fill="#000">
            <ellipse cx="62" cy="67.8" rx="4.5" ry="7.2" />
            <ellipse cx="100" cy="67.8" rx="4.5" ry="7.2" />
          </g>
        </g>
      </g>
      <circle cx="81" cy="80" r="1.9" fill="#ac5c51" />
      <path d="M76 85c2 5 8 5 10 0" fill="none" stroke="#ac5c51" stroke-width="1.6" stroke-linecap="round" />
    </g>
    </g>

    <g class="octocat-paws">
      <path d="M64 119c-5-1-10 0-12 3-5-1-10 0-11 3-1 4 3 7 10 7 11 0 18-3 18-8Z" />
      <path d="M97 119c5-1 10 0 12 3 5-1 10 0 11 3 1 4-3 7-10 7-11 0-18-3-18-8Z" />
      <path d="m48 125 1 3m6-4 1 4m51-4-1 4m8-3-1 3" fill="none" stroke="#c3e3d7" stroke-width="1.2" stroke-linecap="round" />
    </g>
  </svg>
</span>

<style>
  .octocat-rest {
    position: absolute;
    top: 1px;
    left: calc(50% + 24px);
    width: 80px;
    height: 66px;
    transform: translateX(-50%);
    color: #000;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }
  .octocat-art { width: 100%; height: 100%; overflow: visible; }
  .octocat-head { transform-box: fill-box; transform-origin: 50% 90%; }
  .octocat-eyelids { transform-box: fill-box; transform-origin: center; }
  /* Static by default: no JavaScript means a complete, forward-looking pose. */
  :global(html[data-motion-state='running']) .octocat-head,
  :global(html[data-motion-state='paused']) .octocat-head,
  :global(html[data-motion-state='hidden']) .octocat-head { animation: octocat-look 14s var(--ease-in-out) infinite; }
  :global(html[data-motion-state='running']) .octocat-pupils,
  :global(html[data-motion-state='paused']) .octocat-pupils,
  :global(html[data-motion-state='hidden']) .octocat-pupils { animation: octocat-gaze 14s var(--ease-in-out) infinite; }
  :global(html[data-motion-state='running']) .octocat-eyelids,
  :global(html[data-motion-state='paused']) .octocat-eyelids,
  :global(html[data-motion-state='hidden']) .octocat-eyelids { animation: octocat-blink 7s linear infinite; }

  @keyframes octocat-look {
    0%, 28.57%, 47.14%, 61.43%, 80%, 100% { transform: translateX(0) rotate(0); }
    32.86%, 42.86% { transform: translateX(-1px) rotate(-2deg); }
    65.71%, 75.71% { transform: translateX(1px) rotate(2deg); }
  }
  @keyframes octocat-gaze {
    0%, 28.57%, 47.14%, 61.43%, 80%, 100% { transform: translateX(0); }
    32.86%, 42.86% { transform: translateX(-3px); }
    65.71%, 75.71% { transform: translateX(3px); }
  }
  @keyframes octocat-blink {
    0%, 91%, 95%, 100% { transform: scaleY(1); }
    93% { transform: scaleY(.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .octocat-rest .octocat-head,
    .octocat-rest .octocat-pupils,
    .octocat-rest .octocat-eyelids { animation: none !important; transform: none; }
  }
</style>
