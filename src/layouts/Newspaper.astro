---
import displayFont from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-standard-normal.woff2?url';
import '../styles/global.css';
import { profile, publication } from '../data/portfolio';
interface Props { title?: string; description?: string; noIndex?: boolean; }
const {
  title = `${profile.name ?? publication.title} · Desarrollador backend`,
  description = 'Portafolio de ingeniería de software con especialización en backend. Java, Spring Boot, APIs REST y bases de datos relacionales. Lima, Perú.',
  noIndex = false,
} = Astro.props;
const socialImage = Astro.site ? new URL('/og-image.png', Astro.site).href : '/og-image.png';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es" data-motion-state="static">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F5F0E6" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={publication.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Daily Post · Ingeniería de software con enfoque backend" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="newspaper"><slot /></div>
    <script>
      import '../scripts/portfolio';
    </script>
  </body>
</html>
